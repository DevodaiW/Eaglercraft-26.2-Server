#!/bin/bash
set -e

# Clone EaglerProxy repo
git clone https://github.com/WorldEditAxe/eaglerproxy.git proxy-app
cd proxy-app

# Install dependencies with legacy Node typings & TypeScript 4.8.4
npm install
npm install typescript@4.8.4 @types/node@16 --save-dev

# Generate EagPaaS dynamic configuration for ALL servers
cat << 'EOF' > config.ts
export const config = {
  bindHost: "0.0.0.0",
  bindPort: 8081,
  maxConcurrentClients: 200,
  client: {
    version: "1.8.8",
    brand: "EaglerProxy Relay"
  },
  adapter: {
    name: "EagPaaS",
    version: "1.0",
    useNatives: true
  }
};
EOF

# Compile TypeScript
./node_modules/.bin/tsc
