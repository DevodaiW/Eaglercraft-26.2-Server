#!/bin/bash
set -e

# Clone repository into proxy-app if not already present
if [ ! -d "proxy-app" ]; then
  git clone https://github.com/WorldEditAxe/eaglerproxy.git proxy-app
fi

cd proxy-app

# Install dependencies and local TypeScript compiler
npm install
npm install typescript@4.8.4 --save-dev

# Write tsconfig.json that forces JavaScript output into build/ regardless of type warnings
cat << 'EOF' > tsconfig.json
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./build",
    "rootDir": "./src",
    "strict": false,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*"]
}
EOF

# Write full EagPaaS configuration file with default and named exports
cat << 'EOF' > config.ts
export const config = {
  bindHost: "0.0.0.0",
  bindPort: 8081,
  maxConcurrentClients: 200,
  client: {
    version: "1.8.8",
    brand: "EaglerProxy Relay"
  },
  server: {
    host: "127.0.0.1",
    port: 25565
  },
  motd: {
    l1: "EaglerProxy",
    l2: "Powered by EagPaaS"
  },
  skins: {
    skinUrl: "https://textures.minecraft.net/texture/",
    cache: {
      enabled: true,
      maxAge: 86400000
    }
  },
  adapter: {
    name: "EagPaaS",
    version: "1.0",
    useNatives: true
  }
};

export default config;
EOF

# Copy config to src/ directory
cp config.ts src/config.ts

# Compile TypeScript into build/ directory
./node_modules/.bin/tsc || true
