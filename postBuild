#!/bin/bash
set -e

# Clone repository
git clone https://github.com/WorldEditAxe/eaglerproxy.git proxy-app
cd proxy-app

# Install dependencies and explicitly install TypeScript locally
npm install
npm install typescript@4.8.4 --save-dev

# Configure TypeScript build settings
cat << 'EOF' > tsconfig.json
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./build",
    "rootDir": "./src",
    "strict": false,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*"]
}
EOF

# Write EagPaaS dynamic routing config
cat << 'EOF' > config.ts
export const config = {
  bindHost: "0.0.0.0",
  bindPort: 8081,
  maxConcurrentClients: 200,
  client: {
    version: "1.8.8",
    brand: "EaglerProxy Relay"
  },
  adapter: {
    name: "EagPaaS",
    version: "1.0",
    useNatives: true
  }
};
EOF

# Compile source files locally
./node_modules/.bin/tsc || true
