#!/bin/bash
git clone https://github.com/WorldEditAxe/eaglerproxy.git proxy-app
cd proxy-app
npm install
npm install typescript@4.8.4 @types/node@16 --save-dev

cat << 'EOF' > config.ts
export const config = {
  bindHost: "0.0.0.0",
  bindPort: 8081,
  maxConcurrentClients: 200,
  client: {
    version: "1.8.8",
    brand: "EaglerProxy Relay"
  },
  adapter: {
    name: "EaglerProxy",
    version: "1.0",
    useNatives: true
  }
};
EOF

./node_modules/.bin/tsc
