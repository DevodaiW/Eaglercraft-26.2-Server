#!/bin/bash

# 1. Download EaglerProxy
git clone https://github.com/WorldEditAxe/eaglerproxy.git proxy-app
cd proxy-app

# 2. Install dependencies
npm install

# 3. Create the configuration file
# This forces the proxy to bind to 0.0.0.0:8081 so Binder can see it.
cat << 'EOF' > config.ts
export const config = {
    bindHost: "0.0.0.0",
    bindPort: 8081,
    maxConcurrentClients: 200,
    client: {
        version: "1.8.8",
        brand: "EaglerProxy Relay"
    },
    adapter: {
        name: "EaglerProxy",
        version: "1.0",
        useNatives: true
    }
};
EOF

# 4. Compile the code
npx tsc
