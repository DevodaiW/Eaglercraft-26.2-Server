#!/bin/bash
set -e

# Clone repository
git clone https://github.com/WorldEditAxe/eaglerproxy.git proxy-app
cd proxy-app

# Install dependencies and tsx execution runner
npm install
npm install tsx --save-dev

# Write EagPaaS dynamic routing config
cat << 'EOF' > config.ts
export const config = {
  bindHost: "0.0.0.0",
  bindPort: 8081,
  maxConcurrentClients: 200,
  client: {
    version: "1.8.8",
    brand: "EaglerProxy Relay"
  },
  adapter: {
    name: "EagPaaS",
    version: "1.0",
    useNatives: true
  }
};
EOF
